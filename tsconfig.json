{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // The vendored auto-mode copy keeps its upstream `./x.ts` import style.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "target": "ES2022",
    "types": ["node"],
    "paths": {
      "@/*": ["./*"],
      "next/navigation": ["./renderer/shims/next-navigation.ts"],
      "next/image": ["./renderer/shims/next-image.tsx"],
      "next/font/google": ["./renderer/shims/next-font.ts"],
      "next/server": ["./desktop/shims/next-server.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "lib/**/*.test.mjs",
    "**/*.test.mjs"
  ]
}
